# ── BINventory — .env ─────────────────────────────────────────────────────────
# Copy to .env and edit. `docker compose` reads it automatically.

# Port on your host. Open https://<this-machine>:<HOST_PORT>
HOST_PORT=5000

# Port for the AI Assistant (MCP) plugin, published on this machine only.
MCP_PORT=5050

# This machine's LAN IP (the address your phone will use), written into the
# self-signed HTTPS certificate. Find it with `ipconfig` (Windows),
# `ipconfig getifaddr en0` (macOS) or `hostname -I` (Linux).
# If it changes later, delete the old certificate and restart:
#   docker compose exec binventory rm /app/data/certs/cert.pem /app/data/certs/key.pem
#   docker compose restart
HOST_LAN_IP=

# Memory ceiling for the container. CLIP + OCR together need ~2.5 GB while
# working; 4g leaves headroom. 2g is enough if you never use OCR.
MEM_LIMIT=4g

# 1 = plain HTTP instead of HTTPS (phone camera capture won't work).
BINVENTORY_HTTP=0
